# Copie para .env (cp .env.example .env). Nunca versione o .env real.
NODE_ENV=development
PORT=3000
# Obrigatório em produção. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_TTL_SECONDS=3600
LOG_LEVEL=info
# false = inicia sem os dados de demonstração
SEED_DEMO=true
